#!/usr/bin/env -S uv run --quiet python
"""Where models trip in bh-02: a count of the telltale moments in real sessions' transcripts.

Reads every session's `transcript.jsonl` under bh-02's state directory (`$XDG_STATE_HOME/bh-02/
sessions`, else `~/.local/state/bh-02/sessions`, or `--sessions DIR`) and counts, per signal,
how often it happened and in how many sessions, with a few examples of each. A transcript holds
the conversation since its last /clear; a session's `rows.jsonl` says when each run of bh-02 on it
began, so work redone after a resume, in a new REPL, is not counted as a reuse miss. Run it after using bh-02 for a while: the signals that
come up most are where the prompt, the Python process or the loop should change next.

    scripts/model-friction                 # every session here
    scripts/model-friction --model local/qwen    # only the sessions that started on one model
    scripts/model-friction --examples 5    # more examples per signal
    scripts/model-friction --json          # the findings, for another tool

The signals match the texts bh-02 itself writes (the loop's refusals and nudges, the asides
told with a result), so a change to one of those texts is a change here too. It is the
standard library alone.
"""

import argparse
import ast
import itertools
import json
import os
import re
import shlex
import sys
from collections.abc import Iterator, Mapping, Sequence
from dataclasses import dataclass
from pathlib import Path
from typing import Any

type Message = Mapping[str, Any]

# What each signal means, in the order the report lists them.
SIGNALS = {
    "no_such_tool": (
        "called a tool that does not exist (Claude Code's Bash, Read, Edit, ...): it thought it was elsewhere"
    ),
    "no_code": "called python without a `code` string",
    "nudged": (
        "a step the loop had to send back (cut off at the output limit, empty, or a call that did not decode)"
    ),
    "shell_shaped": "an input that only ran programs and printed what they said: the REPL used as a shell",
    "shell_for_files": "ran cat, sed, ls or the like through a shell, for work Python does itself",
    "error": "an input that raised",
    "forgotten_name": (
        "a NameError for a name the REPL never had: usually one an earlier session or REPL defined"
    ),
    "uncaptured_output": "ran a program without capturing its output, so the input saw nothing of it",
    "timeout": "a program that ran out of its timeout",
    "cut_output": "an input whose output was cut at 20,000 characters",
    "repl_restarted": "the REPL died and was started again",
    "reuse_miss": (
        "redid work a variable held (read files, ran a program, called a tool) in the same REPL, "
        "with nothing between that could change it: a floor"
    ),
    "declined": "an input the person said no to (unjailed)",
    "interrupted": "a reply the person stopped mid-input",
    "claude_code": "the model's own text mentions Claude Code",
    "extension_written": "an input that wrote into .bh-02/plugins (the model extending bh-02)",
    "instructions_changed": (
        "the model was told its instructions changed mid-conversation (an extension, a branch, CLAUDE.md)"
    ),
    "startup_file": "an input that wrote .bh-02/startup.py (the model keeping functions for later sessions)",
}
_STARTUP_FILE = ".bh-02/startup.py"  # the project's startup file, the one the model may write
_PROGRAM = re.compile(r"\b(?:subprocess\.(?:run|call|check_call|Popen)|os\.system)\(")
_CAPTURED = re.compile(r"capture_output\s*=\s*True|stdout\s*=|check_output\(")
_EXCEPTION = re.compile(r"^(\w+(?:\.\w+)*(?:Error|Exception|Exit|Interrupt|Expired)):", re.M)
_WRITES = re.compile(r"write_text\(|open\([^)]*['\"][wa]")
_CHANGED = "(bh-02: your instructions have changed since this conversation began."  # the loop's aside
# What makes an input more than a shell command and a print: logic of its own.
_COMPOSING = (ast.comprehension, ast.Compare, ast.BoolOp, ast.IfExp, ast.Lambda)


# What an input runs (`_programs`), and which of those are shell commands for work Python does
# itself (`_shelled`), by kind of work. Searching (grep, rg) is not one: a program that knows
# what git ignores is fair to run.
_KINDS = {
    "read": ("cat", "head", "tail", "wc"),
    "edit": ("sed", "awk"),
    "write": ("tee",),
    "list": ("ls", "find", "tree"),
    "files": ("mkdir", "touch", "cp", "mv", "rm"),
}
_KIND_OF = {command: kind for kind, commands in _KINDS.items() for command in commands}
_RUNNERS = {
    "subprocess": {"run", "call", "check_call", "check_output", "Popen", "getoutput", "getstatusoutput"},
    "os": {"system", "popen"},
}
_SHELLS = {"sh", "bash", "zsh"}
_SEPARATORS = {"|", "||", "&&", ";", "&", "(", ")"}


def _programs(code: str) -> tuple[tuple[str, bool], ...]:
    """Each program `code` runs through subprocess or os (each command of a shell line), by
    name, with whether its output is sent to a file, in the order they appear: () for none, and
    for code that does not parse."""
    try:
        tree = ast.parse(code)
    except SyntaxError, ValueError:
        return ()
    return tuple(found for line in _command_lines(tree) for found in _split(line))


def _shelled(code: str) -> tuple[tuple[str, str], ...]:
    """The shell commands `code` runs for work Python does itself, as (command, kind of work),
    each command once, in the order they appear."""
    found: dict[str, str] = {}
    for name, redirected in _programs(code):
        kind = "write" if redirected else _KIND_OF.get(name)
        if kind is not None:
            found.setdefault(name, kind)
    return tuple(found.items())


def _command_lines(tree: ast.AST) -> Iterator[str]:
    """Each command an input runs through subprocess or os, as shell text: a string as written
    (an f-string up to its first field), a list's leading words quoted, `sh -c`'s script."""
    modules = {"subprocess": "subprocess", "os": "os"}  # a name in the input -> the module
    functions: dict[str, tuple[str, str]] = {}  # an imported function's name -> (module, function)
    for node in ast.walk(tree):
        if isinstance(node, ast.Import):
            modules |= {a.asname or a.name: a.name for a in node.names if a.name in _RUNNERS}
        elif isinstance(node, ast.ImportFrom) and node.module in _RUNNERS:
            functions |= {a.asname or a.name: (node.module, a.name) for a in node.names}
    for node in ast.walk(tree):
        if not isinstance(node, ast.Call):
            continue
        func = node.func
        if isinstance(func, ast.Attribute) and isinstance(func.value, ast.Name):
            module, name = modules.get(func.value.id, ""), func.attr
        elif isinstance(func, ast.Name) and func.id in functions:
            module, name = functions[func.id]
        else:
            continue
        if name not in _RUNNERS.get(module, ()):
            continue
        given = node.args[0] if node.args else None
        given = given or next((k.value for k in node.keywords if k.arg in ("args", "cmd", "command")), None)
        if isinstance(given, ast.List | ast.Tuple):
            words: list[str] = []
            for element in given.elts:
                if not (isinstance(element, ast.Constant) and isinstance(element.value, str)):
                    break
                words.append(element.value)
            if len(words) > 2 and os.path.basename(words[0]) in _SHELLS and words[1] in ("-c", "-lc"):
                yield words[2]
            elif words:
                yield shlex.join(words)
        elif isinstance(given, ast.Constant) and isinstance(given.value, str):
            yield given.value
        elif isinstance(given, ast.JoinedStr):
            parts = []
            for part in given.values:
                if not (isinstance(part, ast.Constant) and isinstance(part.value, str)):
                    break
                parts.append(part.value)
            yield "".join(parts)


def _split(text: str) -> Iterator[tuple[str, bool]]:
    """Each command in shell text, by name, and whether its output is sent to a file (`>` or
    `>>`, not to /dev/null). A here-document's lines are its text, not commands."""
    ending: str | None = None  # the line that ends the here-document being read
    for line in text.splitlines():
        if ending is not None:
            ending = None if line.strip() == ending else ending
            continue
        try:
            lexer = shlex.shlex(line, posix=True, punctuation_chars=True)
            lexer.whitespace_split = True
            words = list(lexer)
        except ValueError:  # an unclosed quote: the words as they split
            words = line.split()
        ending = next(
            (after.lstrip("-") for before, after in itertools.pairwise(words) if before == "<<"), None
        )
        segment: list[str] = []
        for word in [*words, ";"]:
            if word not in _SEPARATORS:
                segment.append(word)
                continue
            names = [w for w in segment if not (w.partition("=")[0].isidentifier() and "=" in w)]
            if names:
                targets = [after for before, after in itertools.pairwise(segment) if before in (">", ">>")]
                yield os.path.basename(names[0]), any(t != "/dev/null" for t in targets)
            segment = []


@dataclass(frozen=True, slots=True)
class Finding:
    """One moment: which signal, in which session, and a line or two to recognise it by."""

    signal: str
    session: str
    detail: str


@dataclass(frozen=True, slots=True)
class Totals:
    sessions: int
    replies: int
    inputs: int


def _short(text: str, width: int = 160) -> str:
    one = " ".join(str(text).split())
    return one if len(one) <= width else one[: width - 1] + "…"


def _calls(messages: Sequence[Message]) -> dict[str, Mapping[str, Any]]:
    """Every tool call by id, so a result can be read beside the code it answers."""
    return {
        str(call.get("id")): call
        for message in messages
        if message.get("role") == "assistant"
        for call in message.get("tool_calls") or ()
    }


def findings(session: str, messages: Sequence[Message], runs: Sequence[str] = ()) -> Iterator[Finding]:
    """The signals in one transcript, pure: what happened, never why. `runs`: when each run of
    bh-02 on the session began, which `reuse_misses` needs."""
    calls = _calls(messages)
    inputs: list[Input] = []
    for message in messages:
        role, content = message.get("role"), str(message.get("content") or "")
        if role in ("user", "tool") and _CHANGED in content:
            yield Finding("instructions_changed", session, _short(content.split(_CHANGED, 1)[1]))
        if role == "user" and message.get("feedback"):
            yield Finding("nudged", session, str(message["feedback"]))
        elif role == "assistant" and "Claude Code" in content:
            yield Finding("claude_code", session, _short(content))
        elif role == "tool":
            call = calls.get(str(message.get("call_id")), {})
            code = str((call.get("input") or {}).get("code") or "")
            yield from _one_input(session, code, _result(message))
            record = message.get("call")
            at = str(record.get("at") or "") if isinstance(record, dict) else ""
            inputs.append(Input(str(call.get("name") or ""), code, _result(message), at))
        if role == "assistant":
            for call in message.get("tool_calls") or ():
                code = str((call.get("input") or {}).get("code") or "")
                if ".bh-02/plugins" in code and _WRITES.search(code):
                    yield Finding("extension_written", session, _short(code))
                if _STARTUP_FILE in code and _WRITES.search(code):
                    yield Finding("startup_file", session, _short(code))
    yield from reuse_misses(session, inputs, runs)


def _shell_shaped(code: str) -> bool:
    """An input whose statements (its imports aside) only run programs and print or keep what
    they said, with no logic of its own: no loop, condition, comprehension or definition."""
    try:
        body = [s for s in ast.parse(code).body if not isinstance(s, ast.Import | ast.ImportFrom)]
    except SyntaxError, ValueError:
        return False
    return bool(body and _programs(code)) and all(
        isinstance(s, ast.Expr | ast.Assign) and not any(isinstance(n, _COMPOSING) for n in ast.walk(s))
        for s in body
    )


def _result(message: Message) -> str:
    """What a `tool` entry's input gave, without what bh-02 told with it: the asides the loop kept
    on the entry (`asides`), which its text has after the result, and any change in the
    instructions after them."""
    told = str(message.get("content") or "").split(f"\n\n{_CHANGED}", 1)[0]
    asides = message.get("asides")
    if isinstance(asides, list):
        return told.removesuffix("".join(f"\n\n{aside}" for aside in asides))
    return told


def _one_input(session: str, code: str, result: str) -> Iterator[Finding]:
    if _shell_shaped(code):
        yield Finding("shell_shaped", session, _short(code))
    if found := _shelled(code):
        yield Finding("shell_for_files", session, f"{', '.join(c for c, _ in found)}: {_short(code, 100)}")
    if result.startswith("error: there is no tool named"):
        yield Finding("no_such_tool", session, _short(result))
        return
    if result.startswith("error: python takes `code`"):
        yield Finding("no_code", session, _short(result))
        return
    if result.startswith("denied: the person said no"):
        yield Finding("declined", session, _short(code))
        return
    if result.startswith(("interrupted: the person stopped", "not run: the person stopped")):
        yield Finding("interrupted", session, _short(code))
        return
    if result.startswith("(the REPL was started again"):
        yield Finding("repl_restarted", session, _short(code))
    if "Traceback (most recent call last)" in result or result.startswith("SyntaxError"):
        kinds = _EXCEPTION.findall(result)
        kind = kinds[-1] if kinds else "SyntaxError" if "SyntaxError" in result else "?"
        yield Finding("error", session, f"{kind}: {_short(code, 100)}")
        if "has not been defined in this REPL" in result:
            yield Finding("forgotten_name", session, _short(code))
        if kind.endswith("TimeoutExpired"):
            yield Finding("timeout", session, _short(code))
    if "characters cut here" in result or "more chars]" in result:
        yield Finding("cut_output", session, _short(code))
    quiet = result.strip() in ("(no output)", "0") or result.lstrip().startswith("CompletedProcess(")
    if quiet and _PROGRAM.search(code) and not _CAPTURED.search(code):
        yield Finding("uncaptured_output", session, _short(code))


# What makes an expression work worth keeping: a call that reads the disk, runs a program or calls
# one of bh-02's tools (`tools.NAME`), by the function's own name.
_WORK = {
    "read_text", "read_bytes", "readlines", "open", "glob", "rglob", "iterdir", "walk", "listdir",
    "scandir", "run", "check_output", "getoutput", "getstatusoutput", "popen", "system",
}  # fmt: skip
# The programs that change no file, and git's subcommands that change nothing.
_READ_ONLY = {
    "cat",
    "head",
    "tail",
    "wc",
    "ls",
    "find",
    "tree",
    "grep",
    "rg",
    "sort",
    "uniq",
    "echo",
    "pwd",
    "diff",
}
_GIT_READS = re.compile(r"\bgit\s+(?:-C\s+\S+\s+)?(?:status|diff|log|show|ls-files|grep|blame|rev-parse)\b")
_NOT_RUN = ("denied:", "interrupted:", "not run:", "error:")  # a result whose input never ran
_RESTARTED = "(the REPL was started again"  # the opening's first aside, in a new worker's first input
# What has a scope of its own, whose names an input's namespace never holds.
_SCOPES = (
    ast.FunctionDef, ast.AsyncFunctionDef, ast.ClassDef, ast.Lambda,
    ast.ListComp, ast.SetComp, ast.DictComp, ast.GeneratorExp,
)  # fmt: skip


@dataclass(frozen=True, slots=True)
class Input:
    """One call the model made, as the reuse signal reads it: the tool, its code (python's; "" for
    another tool's), what it gave, and when it reached approval (`at`, "" when not recorded)."""

    tool: str
    code: str
    result: str
    at: str


@dataclass(frozen=True, slots=True)
class _Kept:
    """An expression whose value a variable holds: the variable, and the names the expression
    reads (binding one of them again means running it again is not a miss)."""

    name: str
    reads: frozenset[str]


def _works(node: ast.AST) -> bool:
    """Whether evaluating `node` reads the disk, runs a program or calls a tool."""
    for inner in ast.walk(node):
        if not isinstance(inner, ast.Call):
            continue
        func = inner.func
        if isinstance(func, ast.Attribute) and isinstance(func.value, ast.Name) and func.value.id == "tools":
            return True
        if (func.attr if isinstance(func, ast.Attribute) else getattr(func, "id", None)) in _WORK:
            return True
    return False


def _bound(statement: ast.stmt) -> set[str]:
    """The names a top-level statement binds or deletes in the namespace (an assignment's targets, a
    loop's, a `with`'s, an import, a def or a class), not those a function or comprehension keeps
    to itself."""
    names: set[str] = set()
    pending: list[ast.AST] = [statement]
    while pending:
        node = pending.pop()
        if isinstance(node, ast.FunctionDef | ast.AsyncFunctionDef | ast.ClassDef):
            names.add(node.name)
            if node is not statement:
                continue
            pending.extend(node.decorator_list)
            continue
        if isinstance(node, ast.Import | ast.ImportFrom):
            names |= {(a.asname or a.name).partition(".")[0] for a in node.names}
        elif isinstance(node, ast.Name) and isinstance(node.ctx, ast.Store | ast.Del):
            names.add(node.id)
        elif isinstance(node, ast.NamedExpr) and isinstance(node.target, ast.Name):
            names.add(node.target.id)
        if isinstance(node, _SCOPES) and node is not statement:
            continue
        pending.extend(ast.iter_child_nodes(node))
    return names


def _changes_files(statement: ast.stmt) -> bool:
    """Whether a statement could change what an expression kept before it would give: it writes a
    file, calls a tool, or runs a program that is not read-only (or sends one's output to a file)."""
    text = ast.unparse(statement)
    if _WRITES.search(text) or re.search(r"\btools\.\w+\(", text):
        return True
    for line in _command_lines(statement):
        for name, redirected in _split(line):
            if redirected or not (name in _READ_ONLY or (name == "git" and _GIT_READS.search(line))):
                return True
    return False


def _new_repl(previous: str, now: Input, runs: Sequence[str]) -> bool:
    """Whether `now` ran in another REPL than the input before it (`previous`, its `at`): its result
    opens with the REPL started again, or a run of bh-02 began between the two (a resume)."""
    if any(line.startswith(_RESTARTED) for line in now.result.splitlines()[:3]):
        return True
    return bool(previous and now.at) and any(previous < run <= now.at for run in runs)


def reuse_misses(session: str, inputs: Sequence[Input], runs: Sequence[str] = ()) -> Iterator[Finding]:
    """The inputs that computed again what a variable already held (`reuse_miss`), pure. `runs`:
    when each run of bh-02 on this session began (`rows.jsonl`), so a resumed session's new REPL is
    not counted as forgetting the old one's. An expression is kept when a top-level assignment of an
    input that ran without an error binds it to a name, and it works (`_works`); it is computed again
    when a later top-level statement holds the same expression, as `ast.unparse` writes it. Anything
    that might change its answer forgets it: a statement that changes files, another tool's call,
    binding again the name that holds it or a name it reads, a new REPL."""
    kept: dict[str, _Kept] = {}
    previous = ""
    for number, one in enumerate(inputs, 1):
        if _new_repl(previous, one, runs) or one.tool != "python":
            kept = {}  # another tool may have changed anything
        previous = one.at or previous
        if one.tool != "python" or one.result.startswith(_NOT_RUN):
            continue
        try:
            body = ast.parse(one.code).body
        except SyntaxError, ValueError:
            continue
        failed = "Traceback (most recent call last)" in one.result
        said: set[str] = set()
        for statement in body:
            for source, how in _done_again(statement, kept):
                if source not in said:
                    said.add(source)
                    yield Finding("reuse_miss", session, f"input {number}, {how}: {_short(source, 100)}")
            kept = _after(statement, {} if _changes_files(statement) else kept, keeps=not failed)


def _kept_as(statement: ast.stmt) -> tuple[str, ast.expr] | None:
    """The name and the expression of a statement that keeps one value in one name (`x = ...`)."""
    if isinstance(statement, ast.Assign) and len(statement.targets) == 1:
        target = statement.targets[0]
        if isinstance(target, ast.Name):
            return target.id, statement.value
    return None


def _done_again(statement: ast.stmt, kept: Mapping[str, _Kept]) -> Iterator[tuple[str, str]]:
    """Each expression in a top-level statement that a variable already holds (`kept`), with how
    it was done again: kept again in the same name, kept under another, or used without keeping. A
    def or a class runs nothing of its body yet, so it does nothing again."""
    if isinstance(statement, _SCOPES):
        return
    keeps = _kept_as(statement)
    for node in ast.walk(statement):
        if not isinstance(node, ast.expr) or not _works(node) or (source := ast.unparse(node)) not in kept:
            continue
        was, again = kept[source].name, keeps[0] if keeps and keeps[1] is node else None
        if again == was:
            yield source, f"kept again in `{was}`"
        elif again:
            yield source, f"held by `{was}`, kept again as `{again}`"
        else:
            yield source, f"held by `{was}`, computed again"


def _after(statement: ast.stmt, kept: Mapping[str, _Kept], *, keeps: bool) -> dict[str, _Kept]:
    """What the variables hold after a top-level statement ran: what it bound again forgotten (the
    name holding a value, or one the value was computed from), and what it keeps added, when its
    input ran (`keeps`) and the value is work (`_works`)."""
    bound = _bound(statement)
    after = {s: k for s, k in kept.items() if k.name not in bound and not k.reads & bound}
    if keeps and (keeping := _kept_as(statement)) and _works(keeping[1]):
        name, value = keeping
        reads = frozenset(n.id for n in ast.walk(value) if isinstance(n, ast.Name))
        after[ast.unparse(value)] = _Kept(name, reads)
    return after


def _sessions_dir(given: str | None) -> Path:
    if given:
        return Path(given)
    state = os.environ.get("XDG_STATE_HOME") or str(Path.home() / ".local" / "state")
    return Path(state) / "bh-02" / "sessions"


def _started_on(session: Path) -> str | None:
    """The model a session started on (its meta.json's `stack`), or None when it can't be read."""
    try:
        meta = json.loads((session / "meta.json").read_text(encoding="utf-8"))
    except OSError, ValueError:
        return None
    return meta.get("stack") if isinstance(meta, dict) else None


def _runs(session: Path) -> list[str]:
    """When each run of bh-02 on a session began (its `rows.jsonl`'s `run` lines), oldest first; []
    when there is no such file."""
    try:
        lines = (session / "rows.jsonl").read_text(encoding="utf-8", errors="replace").splitlines()
    except OSError:
        return []
    starts = []
    for line in lines:
        try:
            record = json.loads(line)
        except ValueError:
            continue
        if isinstance(record, dict) and record.get("kind") == "run" and isinstance(record.get("at"), str):
            starts.append(record["at"])
    return sorted(starts)


def _transcripts(root: Path, model: str | None) -> Iterator[tuple[str, list[Message]]]:
    for path in sorted(root.glob("*/transcript.jsonl")):
        if model is not None and _started_on(path.parent) != model:
            continue
        messages: list[Message] = []
        for line in path.read_text(encoding="utf-8", errors="replace").splitlines():
            try:
                if isinstance(loaded := json.loads(line), dict):
                    messages.append(loaded)
            except ValueError:
                continue  # a line cut off when bh-02 was killed mid-write
        yield path.parent.name, messages


def _report(found: Sequence[Finding], totals: Totals, examples: int) -> str:
    lines = [
        f"{totals.sessions} sessions, {totals.replies} replies, {totals.inputs} inputs",
        "",
        f"{'signal':<20}{'count':>7}{'per 100 inputs':>15}{'sessions':>10}  what it means",
    ]
    for signal, meaning in SIGNALS.items():
        hits = [f for f in found if f.signal == signal]
        rate = f"{100 * len(hits) / totals.inputs:.1f}" if totals.inputs else "-"
        sessions = len({f.session for f in hits})
        lines.append(f"{signal:<20}{len(hits):>7}{rate:>15}{sessions:>10}  {meaning}")
    errors: dict[str, int] = {}
    for f in found:
        if f.signal == "error":
            kind = f.detail.split(":", 1)[0]
            errors[kind] = errors.get(kind, 0) + 1
    if errors:
        common = sorted(errors.items(), key=lambda kv: -kv[1])[:8]
        lines += ["", "errors by kind: " + ", ".join(f"{kind} {n}" for kind, n in common)]
    for signal in SIGNALS:
        hits = [f for f in found if f.signal == signal][-examples:]
        if hits:
            lines += ["", f"{signal}, the latest:"]
            lines += [f"  {f.session[:8]}  {f.detail}" for f in hits]
    return "\n".join(lines)


def main(argv: Sequence[str]) -> int:
    parser = argparse.ArgumentParser(description=__doc__.splitlines()[0])
    parser.add_argument("--sessions", help="bh-02's sessions directory (default: its state directory's)")
    parser.add_argument(
        "--model", help="only the sessions that started on this model (by its name, ENDPOINT/MODEL)"
    )
    parser.add_argument("--examples", type=int, default=3, help="examples per signal (default 3)")
    parser.add_argument("--json", action="store_true", help="print the findings as JSON lines")
    args = parser.parse_args(argv)
    root = _sessions_dir(args.sessions)
    if not root.is_dir():
        print(f"no sessions at {root}; run bh-02, or say where with --sessions DIR", file=sys.stderr)
        return 1
    found: list[Finding] = []
    sessions = replies = inputs = 0
    for session, messages in _transcripts(root, args.model):
        sessions += 1
        runs = _runs(root / session)
        replies += sum(1 for m in messages if m.get("role") == "user" and not m.get("feedback"))
        inputs += sum(1 for m in messages if m.get("role") == "tool")
        found.extend(findings(session, messages, runs))
    if args.json:
        for f in found:
            print(json.dumps({"signal": f.signal, "session": f.session, "detail": f.detail}))
    else:
        print(_report(found, Totals(sessions, replies, inputs), args.examples))
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
