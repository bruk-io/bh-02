#!/usr/bin/env -S uv run --script
# /// script
# requires-python = ">=3.14"
# dependencies = ["click"]
# ///
"""Run every pypeeker architecture gate in the workspace.

A gate is a directory whose pyproject.toml has a `[tool.pypeeker]` table: the workspace root
(the rules that span packages) and each library under libs/ that keeps its own (cordis,
cordis-helpers, brig). pypeeker reads the nearest pyproject.toml, so each gate runs from its
own directory, with the repository root on PYTHONPATH so any gate can load the shared rules
in pypeeker_rules/.

`pypeeker check` does not build the index, and against a missing one it reports nothing and
exits 0. It does refresh the entries the index has (a changed file is indexed again, a deleted
one dropped) but never adds one: a new module in an indexed path, or a new path, is not in what
it checks, so it passes silently. So for each gate this first writes `[tool.pypeeker].src` from
the globs in `[tool.arch-check].src` (the layout, not a hand-kept list, decides what is
checked), drops the index entry of each file no src path holds (pypeeker's refresh keeps one
whose file still exists, and find_symbol and the call graph read every entry; if one is still
listed afterwards, pypeeker's layout has changed under the unlink and the gate fails saying so),
indexes each path that holds a file with no index entry (all of them on a fresh checkout, none when
nothing was added) in one `pypeeker index` call per gate, not one per path (a call reconciles pypeeker's
cross-file symbol tree, which reads every entry written so far, so a call per path cost paths
times files: the root gate's 29 paths took 55 s cold, in one call 4 s), fails on any indexing error,
then runs `check --strict` (plain `check` hides heuristic findings). It writes that list only when
it changes (a member was added), through a temporary file and a rename, because scripts/check runs
pytest, ruff and mypy beside it and each reads pyproject.toml as it starts.

With `--fix` (the default) a gate runs `check --strict --fix` once, and nothing else: it prints a JSON report
of the fixes it applied and the findings left (`residual_findings`, the lines a plain check prints, in its
order), and exits non-zero exactly when findings remain. Exit 0 is a clean gate (after the fixes, if it
applied any); otherwise the findings are the report's, so a gate whose findings no fix applies to runs its
rules once, and one that applied a fix runs them twice (before and after, inside pypeeker) with no
third run to read what is left. With `--no-fix` it is one plain `check --strict`.
(A plain check first, kept for a clean gate, was cheaper there, 36 s against 54 s for `--fix` on the root
gate, since `--fix` also collects each fixable rule's repairs; but every gate with findings then ran the
rules twice, the plain check and `--fix`, which is what the report's findings remove. The clean gate pays
that collection now.)

The gates share nothing (each has its own pyproject.toml, its own .pypeeker and its own sources),
so they run at the same time and the run takes as long as the slowest gate, the root one, not as
long as all of them. Each gate's output is captured and printed whole, in gate order (the root,
then each library), once it has finished: a gate that ends early waits for the ones before it to
be printed, as scripts/check does for its steps. `--fix` runs at the same time too: pypeeker
applies a gate's fixes as one transaction, kept under that gate's own .pypeeker and written to
files in that gate's own src (and to temporary directories it makes for itself), so two gates
fixing at once touch nothing in common as long as no file is in two gates' src, which the layout
keeps (each library has its own gate, and the root one's src does not include libs/).
"""

import contextlib
import json
import os
import re
import shutil
import subprocess
import sys
import tempfile
import tomllib
from collections.abc import Iterator, Mapping, Sequence
from concurrent.futures import ThreadPoolExecutor
from dataclasses import dataclass
from pathlib import Path
from typing import Any

import click

ROOT = Path(__file__).resolve().parent.parent
PYPEEKER = ("uv", "run", "--quiet", "pypeeker")  # pypeeker, from the workspace environment
# pypeeker's IndexStore keeps the entry of src/a.py at .pypeeker/index/src/a.py.json
INDEX = Path(".pypeeker") / "index"


def gates() -> list[Path]:
    """The root, then every library that keeps a gate of its own."""
    found = [ROOT]
    for pyproject in sorted(ROOT.glob("libs/*/pyproject.toml")):
        if "tool" in (config := tomllib.loads(pyproject.read_text())) and "pypeeker" in config["tool"]:
            found.append(pyproject.parent)
    return found


def pypeeker(gate: Path, *args: str, capture: bool) -> subprocess.CompletedProcess[str]:
    """Run pypeeker from the workspace environment, in the gate's directory."""
    env = {**os.environ, "PYTHONPATH": str(ROOT)}
    return subprocess.run([*PYPEEKER, *args], cwd=gate, text=True, capture_output=capture, env=env)


def expanded(gate: Path, patterns: list[str]) -> list[str]:
    """The directories the globs match, relative to the gate, in a stable order."""
    return sorted({str(p.relative_to(gate)) for pattern in patterns for p in gate.glob(pattern) if p.is_dir()})


def replace_file(path: Path, text: str) -> None:
    """Replace the file at `path` with `text`, so that a process reading it (pytest, ruff and mypy start
    beside arch-check and read pyproject.toml) sees the old file or the new one, never part of one.

    The text goes to a temporary file in the same directory (the same filesystem, so the rename is
    atomic) with the old file's mode, and `os.replace` puts it over the old one. A failure leaves
    the old file as it was and no temporary file behind.

    Raises:
        OSError: The directory cannot be written, or the file replaced.
    """
    descriptor, name = tempfile.mkstemp(dir=path.parent, prefix=f".{path.name}.", suffix=".tmp")
    try:
        with os.fdopen(descriptor, "w", encoding="utf-8") as temporary:
            temporary.write(text)
        shutil.copymode(path, name)
        os.replace(name, path)
    except BaseException:
        with contextlib.suppress(FileNotFoundError):
            os.unlink(name)
        raise


def sync_src(gate: Path) -> list[str]:
    """Write `[tool.pypeeker].src` from `[tool.arch-check].src`, if the gate has one and the list
    changed (atomically: see `replace_file`); return src."""
    pyproject = gate / "pyproject.toml"
    text = pyproject.read_text()
    config = tomllib.loads(text)["tool"]
    patterns = config.get("arch-check", {}).get("src")
    if patterns is None:
        return list(config["pypeeker"]["src"])
    paths = expanded(gate, patterns)
    listing = "src = [\n" + "".join(f'    "{p}",\n' for p in paths) + "]"
    section = re.search(r"^\[tool\.pypeeker\]\n", text, re.M)
    assert section is not None
    entry = re.compile(r"^src = \[.*?\]", re.M | re.S)
    match = entry.search(text, section.end())
    if match is None:
        raise SystemExit(f"arch-check: {pyproject} has [tool.arch-check] but no [tool.pypeeker] src to write")
    updated = text[: match.start()] + listing + text[match.end() :]
    if updated != text:
        replace_file(pyproject, updated)
    return paths


def sources(gate: Path, path: str) -> tuple[str, ...]:
    """The files `pypeeker index PATH` would index, relative to the gate: the .py files beneath a
    directory, or the file itself. A path that is neither (a src entry pointing nowhere) names
    itself, so it has no index entry and `pypeeker index` is the one to refuse it."""
    target = gate / path
    if target.is_dir():
        return tuple(str(file.relative_to(gate)) for file in sorted(target.rglob("*.py")))
    return (str(target.relative_to(gate)),)


def indexed(gate: Path) -> frozenset[str]:
    """The source files the gate's index has an entry for, relative to the gate."""
    root = gate / INDEX
    return frozenset(str(entry.relative_to(root)).removesuffix(".json") for entry in root.rglob("*.json"))


def without_index(files: Mapping[str, Sequence[str]], entries: frozenset[str]) -> tuple[str, ...]:
    """The paths (keys of `files`, each with its source files) that hold a file `entries` lacks.

    A file whose indexing failed has no entry, so its path is named again on every run and the
    error is reported again."""
    return tuple(path for path, found in files.items() if not entries.issuperset(found))


def outside_src(paths: Sequence[str], entries: frozenset[str]) -> tuple[str, ...]:
    """The entries (source files, relative to the gate) that no src path holds, sorted.

    A src path holds the files beneath it, and a file that is itself a src path holds itself.
    `is_relative_to` compares whole path components, so `libs/a` does not hold `libs/ab/x.py`."""
    return tuple(sorted(e for e in entries if not any(Path(e).is_relative_to(path) for path in paths)))


def left_behind(dropped: Sequence[str], entries: frozenset[str]) -> str | None:
    """None when none of the `dropped` entries is in `entries` (what the index lists now); else the
    problem, naming each one that is."""
    left = [entry for entry in dropped if entry in entries]
    if not left:
        return None
    names = "".join(f"\n  {entry}" for entry in left)
    return (
        f"arch-check: dropped {len(left)} index entries that are still listed; pypeeker may keep its entries "
        f"somewhere `drop_entries` does not look now (compare INDEX and `drop_entries` with "
        f"pypeeker/storage/index_store.py):{names}"
    )


def drop_entries(gate: Path, entries: Sequence[str]) -> None:
    """Remove the index entry of each source file in `entries`, at the path IndexStore keeps it (under
    `.pypeeker/index`, with `.json` added: the file `IndexStore.remove` unlinks). pypeeker has no command
    for this: its check drops an entry only when the source file is gone.

    This is a coupling to pypeeker's storage layout, which is pre-1.0 and may change. If it does, the
    unlink finds no file (`missing_ok`, since an entry may already be gone) and drops nothing, and says
    nothing: the orphans stay, and every symbol lookup and the call graph read them again, so the gate
    slows again with no error. `run_gate` therefore reads the index once more after this and fails the
    gate, naming each entry it meant to drop that is still listed (`left_behind`): a layout change
    becomes a failing run, not a slower one. The read is of the layout `indexed` assumes, so a change that
    moves the listing too is for the clean-gate test in test_arch_check.py to notice."""
    for entry in entries:
        (gate / INDEX / f"{entry}.json").unlink(missing_ok=True)


@dataclass(frozen=True)
class Outcome:
    """How a gate ended: whether it passed, and everything it wrote (stdout and stderr)."""

    ok: bool
    output: str


def index(gate: Path, paths: Sequence[str]) -> str | None:
    """Index `paths` in one pypeeker call; None when pypeeker did, else what it reported (a failure,
    which names a path that is not there, or indexing errors, each naming its file)."""
    command = f"pypeeker index {' '.join(paths)}"
    result = pypeeker(gate, "index", *paths, capture=True)
    if result.returncode != 0:
        return result.stdout + result.stderr
    try:
        errors = json.loads(result.stdout).get("errors", [])
    except json.JSONDecodeError:
        return f"{command}: unexpected output\n{result.stdout}"
    if errors:
        return f"{command}: {json.dumps(errors, indent=2)}"
    return None


def applied_note(report: Mapping[str, Any]) -> str:
    """The line saying what `pypeeker check --fix` applied, from its JSON `report`; empty if nothing."""
    if not report.get("tx_id"):
        return ""
    return f"pypeeker applied {len(report.get('fixes', []))} fix(es): tx {report['tx_id']}\n"


def fix_outcome(result: subprocess.CompletedProcess[str]) -> Outcome:
    """How a gate ended, from one `pypeeker check --strict --fix` run: the applied-fix line (if it applied
    any), then the findings left, as the report gives them, then anything it wrote to stderr; ok exactly
    when it exited 0, which pypeeker does only when no finding remains. Output that is not the report (a
    usage error, a traceback), an error envelope, or a failing report with no findings in it (a pypeeker
    older than `residual_findings`) fails the gate with what pypeeker said, in place of findings it did
    not give."""
    try:
        report = json.loads(result.stdout)
    except json.JSONDecodeError:
        return Outcome(False, result.stdout + result.stderr)
    if result.returncode == 0:
        return Outcome(True, applied_note(report) + result.stderr)
    if not (findings := report.get("residual_findings")):
        return Outcome(False, result.stdout + result.stderr)
    lines = "".join(f"{finding}\n" for finding in findings)
    return Outcome(False, applied_note(report) + lines + result.stderr)


def run_gate(gate: Path, fix: bool) -> Outcome:
    """Drop the index entries outside one gate's sources (failing if one is still listed), index what has
    no index in them, then run check --strict: with `fix`, as `check --strict --fix` (pypeeker applies its
    autofixes and the report gives the findings left), else plain."""
    paths = sync_src(gate)
    dropped = outside_src(paths, indexed(gate))
    drop_entries(gate, dropped)
    entries = indexed(gate)
    if (problem := left_behind(dropped, entries)) is not None:
        return Outcome(False, problem)
    if unindexed := without_index({path: sources(gate, path) for path in paths}, entries):
        if (problem := index(gate, unindexed)) is not None:
            return Outcome(False, problem)
    if fix:
        return fix_outcome(pypeeker(gate, "check", "--strict", "--fix", capture=True))
    checked = pypeeker(gate, "check", "--strict", capture=True)
    return Outcome(checked.returncode == 0, checked.stdout + checked.stderr)


def gate_name(gate: Path) -> str:
    """The gate as the repository names it: `(root)`, or its directory (`libs/brig`)."""
    return "(root)" if gate == ROOT else gate.relative_to(ROOT).as_posix()


def report(gate: Path, outcome: Outcome) -> bool:
    """Print a gate's name, everything it wrote and its verdict; whether it passed."""
    click.echo(click.style(f"== {gate_name(gate)}", bold=True))
    if outcome.output:
        click.echo(outcome.output, nl=not outcome.output.endswith("\n"))
    verdict = "   ok" if outcome.ok else f"   FAILED: {gate_name(gate)}"
    click.echo(click.style(verdict, fg="green" if outcome.ok else "red"))
    return outcome.ok


def outcomes(found: Sequence[Path], fix: bool) -> Iterator[Outcome]:
    """Every gate started at once; each outcome yielded in the gates' order, as it is ready."""
    with ThreadPoolExecutor(max_workers=len(found)) as pool:
        yield from pool.map(lambda gate: run_gate(gate, fix), found)


@click.command()
@click.option(
    "--fix/--no-fix",
    default=True,
    help="Apply certain-confidence autofixes as one transaction first (default), or only report.",
)
def main(fix: bool) -> None:
    """Run every gate at the same time; exit non-zero if any fails."""
    found = gates()
    results = [report(gate, outcome) for gate, outcome in zip(found, outcomes(found, fix), strict=True)]
    sys.exit(0 if all(results) else 1)


if __name__ == "__main__":
    main()
