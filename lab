#!/usr/bin/env bash
# The lab's one entry point, so nobody retypes the uv flags.
#   ./lab check [PYTEST ARGS]   the one definition of green: format and lint (checked, not
#                               rewritten), strict types, tests
#   ./lab fix                   apply the formatter and ruff's safe fixes
#   ./lab extract PATH... [-o]  transcripts -> corpus/results.jsonl
#   ./lab stats [...]           corpus size and format report
#   ./lab fold [FILE|-] [...]   fold a file or stdin into a token budget (the tool itself)
#   ./lab evals l1 [...]        layer 1: every eval task folded and checked, no model (free)
#   ./lab evals l2 [...]        layer 2: headless Claude Code on the eval tasks (costs money; --dry-run first)
#   ./lab fetch hdfs            a real corpus into corpus/real/ (Python 3.13 with pyarrow; untracked)
#   ./lab page [-o FILE]        the findings page: results/FINDINGS.md as pages/findings.html
#   ./lab seal init|verify|status   the sealed test set's key, commitment and ledger (SCENARIOS.md)
#   ./lab scenarios [--size M]  layer 1 on the v2 scenarios: open seeds built, their real outputs folded and checked
#   ./lab scenarios-l2 [...]    layer 2 on the v2 scenarios: Claude Code in a fresh world per run (paid; --dry-run first)
set -euo pipefail
cd "$(dirname "$0")"
export UV_SYSTEM_CERTS="${UV_SYSTEM_CERTS:-${UV_NATIVE_TLS:-}}"; unset UV_NATIVE_TLS
run() { uv run --quiet --no-project --python 3.15 --with pytest --with ruff --with "mypy>=2.3" --with ast-grep-py --with fastmcp "$@"; }
cmd="${1:-check}"; shift || true
case "$cmd" in
  check) run ruff format --check . && run ruff check --no-fix . && run mypy && run pytest "$@" ;;
  fix) run ruff format . && run ruff check --fix . ;;
  extract|stats) run python -m "harness.$cmd" "$@" ;;
  evals) layer="${1:-l1}"; shift || true; run python -m "evals.$layer" "$@" ;;
  fold) run python -m compressors.cli "$@" ;;
  page) run python -m pages.findings "$@" ;;
  seal) run python -m scenarios.seal "$@" ;;
  scenarios) run python -m scenarios.l1 "$@" ;;
  scenarios-l2) run python -m scenarios.l2 "$@" ;;
  fetch) uv run --quiet --no-project --python 3.13 --with pyarrow python -m harness.fetch "$@" ;;
  *) echo "unknown command '$cmd': use check, fix, fold, evals, page, seal, scenarios, scenarios-l2, fetch, extract or stats" >&2; exit 2 ;;
esac
